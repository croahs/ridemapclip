# API-key imports need no environment variables. OAuth below is retained but disabled.
# Register an OAuth app at https://intervals.icu/oauth/apply and wait for approval.
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
INTERVALS_REDIRECT_URI=http://localhost:3000/api/intervals/callback
# Generate a stable random value of at least 32 characters. Keep it server-side.
INTERVALS_SESSION_SECRET=
